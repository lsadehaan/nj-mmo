{
  "name": "server",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "server/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["game-core:build"],
      "options": {
        "outputPath": "dist/server",
        "main": "server/src/index.ts",
        "tsConfig": "server/tsconfig.app.json",
        "assets": []
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig server/tsconfig.app.json server/src/index.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/server"],
      "options": {
        "configFile": "server/vitest.config.ts",
        "reportsDirectory": "../coverage/server"
      }
    }
  }
}
