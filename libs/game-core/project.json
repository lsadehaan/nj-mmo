{
  "name": "game-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/game-core/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/game-core",
        "main": "libs/game-core/src/index.ts",
        "tsConfig": "libs/game-core/tsconfig.lib.json",
        "generatePackageJson": true
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/libs/game-core"],
      "options": {
        "configFile": "libs/game-core/vitest.config.mts",
        "reportsDirectory": "../../coverage/libs/game-core"
      }
    }
  }
}
